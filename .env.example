# Postgres. En Vercel conecta Storage → Postgres y usa:
# DATABASE_URL = POSTGRES_PRISMA_URL (con pooler)
# DIRECT_URL   = POSTGRES_URL_NON_POOLING (conexión directa, para migraciones)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/elcalentano?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/elcalentano?sslmode=require"
PORT=4000
HOST=0.0.0.0
# Origen del front. Los dominios *.vercel.app también se aceptan.
CORS_ORIGIN="http://localhost:3000"
BUFFER_MINUTES=5
SLOT_STEP_MINUTES=10
TZ="America/Mexico_City"
CURRENCY="MXN"
NOTIFY_MODE="mock"
# Interruptor real. Con false (o ausente) todo queda simulado: SENT_MOCK.
WHATSAPP_ENABLED="false"
# "ycloud" (coexistencia: el número sigue en WhatsApp Business del celular) o "meta" (Cloud API directo).
WHATSAPP_PROVIDER="ycloud"
YCLOUD_API_KEY=""
# Número conectado en YCloud, 10 dígitos o +52.
YCLOUD_FROM="5554936475"
# Secreto que devuelve YCloud al crear el webhook (whsec_...).
YCLOUD_WEBHOOK_SECRET=""
# Solo si WHATSAPP_PROVIDER="meta":
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_LANG="es_MX"
WHATSAPP_TEMPLATE_CONFIRM="cita_confirmada"
WHATSAPP_TEMPLATE_REMINDER="cita_recordatorio"
WHATSAPP_TEMPLATE_RESCHEDULE="cita_reagendada"
WHATSAPP_TEMPLATE_CANCEL="cita_cancelada"
WHATSAPP_TEMPLATE_BARBER="aviso_barbero"
# Respaldo si el barbero no tiene teléfono en el panel: slug:10digitos,slug:10digitos
WHATSAPP_BARBER_PHONES=""
# Render Cron llama POST /api/cron/recordatorios con este header.
RECORDATORIOS_SECRET=""
PAYMENTS_MODE="mock"
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# STRIPE_SECRET_KEY=
