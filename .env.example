# Postgres. En Vercel conecta Storage → Postgres y usa:
# DATABASE_URL = POSTGRES_PRISMA_URL (con pooler)
# DIRECT_URL   = POSTGRES_URL_NON_POOLING (conexión directa, para migraciones)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/elcalentano?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/elcalentano?sslmode=require"
PORT=4000
HOST=0.0.0.0
# Origen del front. Los dominios *.vercel.app también se aceptan.
CORS_ORIGIN="http://localhost:3000"
BUFFER_MINUTES=5
SLOT_STEP_MINUTES=10
TZ="America/Mexico_City"
CURRENCY="MXN"
NOTIFY_MODE="mock"
PAYMENTS_MODE="mock"
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# STRIPE_SECRET_KEY=
